; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Droidream"
run/main_scene="uid://b0as27ombq3yp"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Utils="*res://Scripts/Data/Utils.gd"
EnemyDatabase="*res://Scripts/Data/EnemyDatabase.gd"
CombatTypes="*res://Scripts/Data/CombatTypes.gd"
PlayerData="*res://Scripts/Data/PlayerData.gd"
ItemDb="*res://Scripts/Data/ItemDB.gd"
AbilityDb="*res://Scripts/Data/AbilityDB.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

